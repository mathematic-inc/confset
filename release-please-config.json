{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "initial-version": "0.1.0",
  "packages": {
    ".": {
      "release-type": "rust",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "README.md",
        "examples/web/confset.pkl",
        "examples/polyglot/confset.pkl",
        "examples/nested/confset.pkl",
        "examples/custom/confset.pkl",
        "examples/nested/config/python.pkl",
        "examples/nested/config/web.pkl"
      ]
    }
  },
  "plugins": [
    "sentence-case"
  ]
}
