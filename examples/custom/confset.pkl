amends
  "package://github.com/mathematic-inc/confset/releases/download/v0.1.1/confset@0.1.0#/Config.pkl" // x-release-please-version

local colorNames = List("red", "green", "blue")
local function render(values: List<String>) =
  values.map((value) -> "--color=" + value).join("\n") + "\n"

files {
  ["application"] {
    path = "app/settings.yaml"
    format = "yaml"
    config {
      enabled = true
      retries = 3
      colors = colorNames
    }
  }
  ["arguments"] {
    path = "colors.args"
    format = "text"
    config = render(colorNames)
  }
}
