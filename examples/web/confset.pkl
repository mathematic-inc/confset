amends
  "package://github.com/mathematic-inc/confset/releases/download/v0.1.0/confset@0.1.0#/Config.pkl" // x-release-please-version

import
  "package://github.com/mathematic-inc/confset/releases/download/v0.1.0/confset@0.1.0#/Builtins.pkl" // x-release-please-version
import
  "package://github.com/mathematic-inc/confset/releases/download/v0.1.0/confset@0.1.0#/Renderers.pkl" // x-release-please-version

local ignored = List("dist/", "coverage/")
local entryModules = List("main", "worker")

tools {
  ["lint"] = (Builtins.oxlint) {
    config {
      categories {
        correctness = "deny"
        suspicious = "deny"
      }
      ignorePatterns = ignored
    }
  }

  ["format"] = (Builtins.oxfmt) {
    config {
      printWidth = 100
      semi = false
    }
    files {
      ["ignore"] {
        path = ".prettierignore"
        format = "text"
        config = Renderers.lines(ignored)
      }
    }
  }

  ["unused"] = (Builtins.knip) {
    config {
      entry = entryModules.map((name) -> "src/\(name).ts")
      project = List("src/**/*.ts")
      ignore = ignored
    }
  }
}
